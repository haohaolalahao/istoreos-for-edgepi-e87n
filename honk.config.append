# ============================================================
#  honk 支持补丁 —— 追加到 iStoreOS 的 .config（make defconfig 之前）
#  用法：cat honk.config.append >> .config && make defconfig
#  背景：honk 的 eBPF 数据面要求内核 6.12+ 且带 BTF（CO-RE），
#        并依赖 3 个内核模块；预编译的 iStoreOS r8 里都没有。
# ============================================================

# ---- 1. 内核 BTF（honk / dae 的 eBPF CO-RE 必需）----
# Config-kernel.in 里：KERNEL_DEBUG_INFO_BTF 依赖 KERNEL_DEBUG_INFO && !KERNEL_DEBUG_INFO_REDUCED
#   → 三个都要显式写，否则 defconfig 会把你 BTF 静默丢掉
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y

# ---- 2. honk 包依赖的内核模块 ----
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y

# ---- 3. 其余 4 个依赖（iStoreOS 默认镜像里已有，写上是保险）----
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nf-conntrack=y

# ---- 4. honk 的用户态依赖（可选；不编进去就刷完再 apk add）----
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# ---- 5. 可选：LuCI 主题 Vantage（github.com/anothaDev/luci-theme-vantage）----
# 需要先在 feeds.conf.default 里加：
#   src-git vantage https://github.com/anothaDev/luci-theme-vantage.git
#   ./scripts/feeds update vantage && ./scripts/feeds install luci-theme-vantage luci-app-vantage
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-app-vantage=y
CONFIG_PACKAGE_luci-i18n-vantage-theme-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vantage-zh-cn=y
